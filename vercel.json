{
  "functions": {
    "api/*.js": {
      "maxDuration": 90
    }
  },
  "crons": [
    {
      "path": "/api/check-alerts",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(langs|posts)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
